PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
DB_PASS=change-me
DB_NAME=auth_db

# must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

THROTTLER_TTL_MS=60000
THROTTLER_LIMIT=100

RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_LIMIT=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_LIMIT=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_API_LIMIT=100
RATE_LIMIT_API_WINDOW_SECONDS=60

# platform (super-admin) account, seeded on first migration run
PLATFORM_ADMIN_EMAIL=admin@platform.local
PLATFORM_ADMIN_PASSWORD=change-me-12-chars-min
